{
	"name": "portfolio",
	"account_id": "4d88efd255dc165e0b7a8cadbde61d50",
	"compatibility_date": "2026-02-13",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "worker.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// Run the Worker before serving assets so www.* requests get redirected
		"run_worker_first": true
	},
	"observability": {
		"enabled": true
	},
	"routes": [
		{ "pattern": "esp-9.dev", "custom_domain": true },
		{ "pattern": "www.esp-9.dev", "custom_domain": true }
	]
}
