{
  "name": "portfolio",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --hot ./index.ts",
    "test:e2e": "playwright test",
    "build": "bun build ./index.html ./things.html ./hire.html ./theme-switch.ts --outdir ./dist --splitting --minify && bun ./blog/build.ts && bun ./work/build.ts && bun ./not-found/build.ts && cp -r ./public/* ./dist/",
    "eyecatch:dry-run": "bun ./blog/eyecatch-dry-run.ts",
    "deploy": "bunx wrangler deploy"
  },
  "devDependencies": {
    "@gltf-transform/extensions": "4.3.0",
    "@playwright/test": "^1.59.1",
    "@types/bun": "latest",
    "meshoptimizer": "1.3.0",
    "shiki": "^4.6.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.3.0",
    "@types/three": "^0.182.0",
    "three": "^0.182.0",
    "wrangler": "^4.65.0"
  }
}
